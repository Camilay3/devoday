generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model cards {
  id          Int    @id @default(autoincrement())
  donoId      Int
  fav         Int    @default(0)
  livro       String @db.VarChar(20)
  capitulo    Int
  versInicial Int
  versFinal   Int
  data        String @db.VarChar(15)
  q1          String
  q2          String
  users       users  @relation(fields: [donoId], references: [id])
}

model frases {
  id         Int    @id @default(autoincrement())
  lastupdate String
  titulo     String
  text       String
}

model users {
  id        Int     @id @default(autoincrement())
  email     String  @unique @db.VarChar(100)
  senha     String  @db.VarChar(255)
  token     Int
  icon      Int     @default(0)
  verify    Int     @default(0)
  num_cards Int     @default(0)
  cards     cards[]
}
