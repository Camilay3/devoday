<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/tuto.css">
    <link rel="shortcut icon" href="/imgs/logo.png" type="image/x-icon">
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css'>
    <title>Devo day</title>
</head>
<body>
    {{> preloader }}

    <div class="cont">
        <a href="/" class="sair">Sair do tutorial</a>
        <img src="/imgs/felizFN.png" alt="guia">
        <div class="txts">
            <div class="text">
                <h1>Bem vindo(a)!</h1>
                <p>Olá! Muito obrigada por entrar nessa jornada conosco! Meu nome é Lia e nesse tutorial vou te mostrar como funciona o devoday! Para começarmos, clique neste botão azul em destaque</p>
            </div>
        </div>
    </div>

    {{> header }}
    <section>
        <div class="cards">
            <form action="/criar/modificar" method="post">
                {{#each cards as | card |}}
                    {{#ifEquals card/fav 0}}
                        <div class="bottom">
                            <div class="card">
                                {{#ifEquals card/versInicial card/versFinal}}
                                    <h1>{{card/livro}} {{card/capitulo}}:{{card/versInicial}}</h1>
                                {{else}}
                                    <h1>{{card/livro}} {{card/capitulo}}:{{card/versInicial}}-{{card/versFinal}}</h1>
                                {{/ifEquals}}

                                {{#ifEquals card/q1 ""}}
                                    {{#ifEquals card/q2 ""}}
                                        <p class="alert">Nenhum texto foi escrito</p>
                                    {{else}}
                                        <p>"{{card/q2}}"</p>
                                    {{/ifEquals}}
                                {{else}}
                                    <p>"{{card/q1}}"</p>
                                {{/ifEquals}}
                                <div class="modificadores">
                                        <input type="submit" name="card" id="fav{{card/id}}" value="fav{{card/id}}" style="display: none;">
                                        <input type="submit" name="card" id="edi{{card/id}}" value="edi{{card/id}}" style="display: none;">
                                        <input type="submit" name="card" id="exc{{card/id}}" value="exc{{card/id}}" style="display: none;">

                                        <label for="fav{{card/id}}"><i class="fi fi-rr-star"></i></label>
                                        <label for="edi{{card/id}}"><i class="fi fi-rr-pencil"></i></label>
                                        <label for="exc{{card/id}}"><i class="fi fi-rr-trash"></i></label>
                                </div>
                                <span class="data">{{card/data}}</span>
                            </div>
                        </div>
                    {{/ifEquals}}
                {{/each}}

                {{#each cards as | card |}}
                    {{#ifEquals card/fav 1}}
                        <div class="top">
                            <div class="card">
                                {{#ifEquals card/versInicial card/versFinal}}
                                    <h1>{{card/livro}} {{card/capitulo}}:{{card/versInicial}}</h1>
                                {{else}}
                                    <h1>{{card/livro}} {{card/capitulo}}:{{card/versInicial}}-{{card/versFinal}}</h1>
                                {{/ifEquals}}

                                {{#ifEquals card/q1 ""}}
                                    {{#ifEquals card/q2 ""}}
                                        <p class="alert">Nenhum texto foi escrito</p>
                                    {{else}}
                                        <p>"{{card/q2}}"</p>
                                    {{/ifEquals}}
                                {{else}}
                                    <p>"{{card/q1}}"</p>
                                {{/ifEquals}}
                                <div class="modificadores">
                                        <input type="submit" name="card" id="fav{{card/id}}" value="fav{{card/id}}" style="display: none;">
                                        <input type="submit" name="card" id="edi{{card/id}}" value="edi{{card/id}}" style="display: none;">
                                        <input type="submit" name="card" id="exc{{card/id}}" value="exc{{card/id}}" style="display: none;">

                                        <label for="fav{{card/id}}"><i class="fi fi-sr-star"></i></label>
                                        <label for="edi{{card/id}}"><i class="fi fi-rr-pencil"></i></label>
                                        <label for="exc{{card/id}}"><i class="fi fi-rr-trash"></i></label>
                                </div>
                                <span class="data">{{card/data}}</span>
                            </div>
                        </div>
                    {{/ifEquals}}
                {{/each}}
            </form>
        </div>

        <div class="coluna">
            <div class="sugestao boxShadow">
                <h2>Sugestão de hoje</h2>
                <h1>{{sugTit}}</h1>
                <p>{{sugTex}}</p>
                <div class="mais">
                    <a href="../sugerido">Iniciar devocional
                    <i class="fi fi-rr-add"></i></a>
                </div>
            </div>

            <div class="conquistas boxShadow">
                <h2>Conquistas</h2>
                <h1>Persistência {{level}}</h1>
                <div class="content">
                    <div class="barra">
                        <span class="feito">{{cardsF}}</span>
                        <progress id="progress" value={{cardsFM}} max={{cardsLevelFM}}></progress>
                        <span class="total">{{cardsLevel}}</span>
                    </div>
                    <p>Faça {{cardsLevel}} devocionais</p>
                </div>
            </div>
        </div>

        <div class="boxShadow novo marcado">
            <a href="../tutorialB"><i class="fi fi-rr-add"></i></a>
        </div>
    </section>
</body>
</html>